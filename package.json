{
  "name": "meowedit",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "A lightweight browser editor for Meowdieval dialogues, quests, and army configurations.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run verify-demo-assets && tsc --noEmit && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "contract:check": "node tools/contract-check.mjs && vitest run tests/v2-contract.test.ts tests/v2-schema-agreement.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "watermark-demo-assets": "node tools/watermark-demo-assets.mjs",
    "verify-demo-assets": "node tools/verify-demo-assets.mjs",
    "confirm-real-assets": "node tools/confirm-real-assets.mjs",
    "snapshot-unit-roster": "node tools/snapshot-unit-roster.mjs",
    "snapshot-army-catalog": "node tools/snapshot-army-catalog.mjs",
    "snapshot-game-capabilities": "node tools/snapshot-game-capabilities.mjs"
  },
  "devDependencies": {
    "@types/drawflow": "^0.0.12",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@neondatabase/auth": "^0.6.0-beta",
    "drawflow": "^0.0.60",
    "zod": "^4.6.7"
  },
  "overrides": {
    "better-auth": "1.7.27",
    "zod": "$zod"
  }
}
